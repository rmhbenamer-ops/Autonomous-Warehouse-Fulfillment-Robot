# Base Code - Defines Pins - Assumed Present
# Assumed Rotary Encoder and Buzzer Code

# Set Up PID Variables
FOLLOW_DISTANCE = 20.0  # Target Distance (cm)
kp = 2.5                 # Proportional Gain
ki = 0.25                # Integral Gain
kd = 0.5                 # Derivative Gain

# Sum of Previous Errors + Integral
integral = 0
prev_error = 0

while True:
    if GPIO.input(PIN_LIMIT_SW) == GPIO.LOW:
        drive_robot(0)
        break

    current_dist = us_sensor.distance * 100  # Metres to cm

    # Calculate Error
    error = current_dist - FOLLOW_DISTANCE

    # Calculate Derivative
    derivative = (error - prev_error) / 0.1

    # Calculate Integral
    integral += error * 0.1

    # Calculate Output (P + I + D Control)
    output = (kp * error) + (ki * integral) + (kd * derivative)

    drive_robot(output)  # Clamps output to +/- 100
    prev_error = error

    # Determine Tracking Status
    if error > 3:
        val_error = "Too Far"
    elif error < -3:
        val_error = "Too Close"
    else:
        val_error = "On Target"

    # Display PID Output and Status
    lcd.printer(f"PID: {output:.0f}, {val_error}")

    time.sleep(0.1)
